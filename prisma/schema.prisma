generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles: SUPERADMIN crea ADMINs; cada ADMIN gestiona su propio tenant
// (racetracks, reuniones, programas, usuarios). Los USERs pertenecen a
// exactamente un ADMIN (User.adminId) y solo ven el contenido de ese tenant.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  displayName  String
  pseudonym    String?
  role         String   @default("USER") // SUPERADMIN | ADMIN | USER
  adminId      Int?
  createdAt    DateTime @default(now())

  admin       User?  @relation("AdminUsers", fields: [adminId], references: [id], onDelete: SetNull)
  managedUsers User[] @relation("AdminUsers")

  picks     Pick[]
  scores    Score[]
  programas Programa[]

  ownedRacetracks Racetrack[] @relation("RacetrackOwner")
  ownedWeeks      RaceWeek[]  @relation("RaceWeekOwner")
  ownedReuniones  Reunion[]   @relation("ReunionOwner")
}

model Racetrack {
  id        Int       @id @default(autoincrement())
  name      String
  city      String
  adminId   Int?
  reuniones Reunion[]
  admin     User?     @relation("RacetrackOwner", fields: [adminId], references: [id], onDelete: SetNull)

  @@unique([adminId, name])
}

model RaceWeek {
  id         Int      @id @default(autoincrement())
  year       Int
  weekNumber Int
  startDate  DateTime
  endDate    DateTime
  adminId    Int?

  reuniones Reunion[]
  admin     User?     @relation("RaceWeekOwner", fields: [adminId], references: [id], onDelete: SetNull)

  @@unique([adminId, year, weekNumber])
}

model Reunion {
  id          Int      @id @default(autoincrement())
  racetrackId Int
  weekId      Int
  adminId     Int?
  name        String
  reunionDate DateTime
  deadline    DateTime
  status      String   @default("OPEN") // OPEN | CLOSED | SETTLED
  createdAt   DateTime @default(now())

  racetrack Racetrack @relation(fields: [racetrackId], references: [id])
  week      RaceWeek  @relation(fields: [weekId], references: [id], onDelete: Cascade)
  admin     User?     @relation("ReunionOwner", fields: [adminId], references: [id], onDelete: SetNull)
  races     Race[]
  document  ReunionDocument?
  programas Programa[]
}

model ReunionDocument {
  reunionId  Int      @id
  filename   String
  data       Bytes
  uploadedAt DateTime @default(now())

  reunion Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)
}

model Race {
  id         Int    @id @default(autoincrement())
  reunionId  Int
  raceNumber Int
  status     String @default("OPEN")

  reunion Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  horses  Horse[]
  picks   Pick[]
  result  Result?
  scores  Score[]

  @@unique([reunionId, raceNumber])
}

model Horse {
  id          Int     @id @default(autoincrement())
  raceId      Int
  number      Int
  name        String
  odds        Float?
  isFavorite  Boolean @default(false)
  isScratched Boolean @default(false)

  race  Race   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  picks Pick[]

  @@unique([raceId, number])
}

model Pick {
  id        Int      @id @default(autoincrement())
  userId    Int
  raceId    Int
  horseId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  race  Race  @relation(fields: [raceId], references: [id], onDelete: Cascade)
  horse Horse @relation(fields: [horseId], references: [id])

  @@unique([userId, raceId])
}

model Result {
  id             Int      @id @default(autoincrement())
  raceId         Int      @unique
  firstHorseId   Int
  secondHorseId  Int
  thirdHorseId   Int
  winnerDividend Float    @default(0)
  settledAt      DateTime @default(now())

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
}

model Score {
  id        Int    @id @default(autoincrement())
  userId    Int
  raceId    Int
  points    Int
  breakdown String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([userId, raceId])
}

model Programa {
  id        Int       @id @default(autoincrement())
  userId    Int
  reunionId Int
  paid      Boolean   @default(false)
  paidAt    DateTime?
  note      String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reunion Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  @@unique([userId, reunionId])
}
